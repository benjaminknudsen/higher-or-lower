# Only used by the local Node importer. Never use a VITE_ prefix.
# Create a direct API-Sports/API-Football account, then paste your own key here in .env.
API_FOOTBALL_KEY=

# Public frontend configuration. Copy your project's publishable key only.
# Never place sb_secret_* or service_role credentials in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
